---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eventify — Eventos presenciales y remotos en LATAM',
  description = 'Conectamos usuarios con eventos y brindamos experiencias unicas tanto presencial como remota en toda Latinoamerica.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh flex flex-col antialiased">
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white focus:font-medium"
    >
      Saltar al contenido principal
    </a>

    <header class="border-b border-slate-200 bg-white/90 backdrop-blur-sm sticky top-0 z-40">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 font-bold text-xl tracking-tight">
          <span
            aria-hidden="true"
            class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white text-sm font-extrabold"
          >
            E
          </span>
          <span>Eventify</span>
          <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">
            LATAM
          </span>
        </a>

        <nav aria-label="Navegación principal" class="flex items-center gap-4 text-sm font-medium text-slate-600">
          <a href="/#eventos" class="hover:text-brand-600 transition-colors">Explorar eventos</a>
          <a href="/?modality=presencial#eventos" class="hover:text-brand-600 transition-colors">Presenciales</a>
          <a href="/?modality=remoto#eventos" class="hover:text-brand-600 transition-colors">Remotos</a>
        </nav>
      </div>
    </header>

    <main id="contenido-principal" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white mt-16">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p class="font-medium text-slate-700">
          Eventify — Conectando personas con experiencias presenciales y remotas en LATAM.
        </p>
        <p>© 2026 Eventify</p>
      </div>
    </footer>
  </body>
</html>
