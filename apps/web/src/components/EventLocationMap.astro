---
import type { EventItem } from '../domain/events/event.types';
import type { MapProvider } from '../domain/maps/map-provider';
import { mapProvider as defaultMapProvider } from '../infrastructure/maps/openstreetmap.provider';

interface Props {
  event: EventItem;
  provider?: MapProvider;
}

const { event, provider = defaultMapProvider } = Astro.props;

const isPhysicalOrHybrid = event.modality === 'presencial' || event.modality === 'hibrido';
const isRemoteOrHybrid = event.modality === 'remoto' || event.modality === 'hibrido';

const mapData =
  isPhysicalOrHybrid && event.geo ? provider.resolveMapData(event.geo) : null;

const fallbackQuery = [event.geo?.address, event.location, event.city, event.country]
  .filter(Boolean)
  .join(', ');

const fallbackSearch =
  isPhysicalOrHybrid && !mapData ? provider.resolveFallbackSearchUrl(fallbackQuery) : null;

const headingText =
  event.modality === 'remoto'
    ? 'Acceso remoto'
    : event.modality === 'hibrido'
      ? 'Ubicación presencial y acceso remoto'
      : 'Ubicación del evento';
---

<section
  aria-labelledby="titulo-ubicacion"
  class="event-location-container rounded-2xl border border-slate-200 bg-white p-6 shadow-xs space-y-6"
>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4">
    <h2 id="titulo-ubicacion" class="text-xl font-bold tracking-tight text-slate-900">
      {headingText}
    </h2>
    {isPhysicalOrHybrid && (
      <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 ring-1 ring-inset ring-emerald-200">
        Mapa abierto · $0
      </span>
    )}
  </div>

  {isPhysicalOrHybrid && (
    <div class="space-y-4">
      <div class="space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          Sede presencial
        </p>
        <p class="text-base font-semibold text-slate-900">{event.location}</p>
        {event.geo?.address && (
          <p class="text-sm text-slate-700">{event.geo.address}</p>
        )}
        <p class="text-sm text-slate-600">
          {event.city}, {event.country}
        </p>
      </div>

      {mapData ? (
        <div class="space-y-3">
          <div class="aspect-video w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
            <iframe
              src={mapData.embedUrl}
              title={`Mapa interactivo de ubicación: ${event.location}, ${event.city}`}
              class="h-full w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer"
              sandbox="allow-scripts allow-same-origin"
            />
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
            <div class="flex flex-wrap gap-2.5">
              <a
                href={mapData.viewUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition-colors"
              >
                Ver en {mapData.providerName}
              </a>
              <a
                href={mapData.directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-800 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 transition-colors"
              >
                Cómo llegar
              </a>
            </div>

            <p class="text-xs text-slate-500">
              Mapa provisto por{' '}
              <a
                href={mapData.attributionUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-slate-300 underline-offset-2 hover:text-brand-700"
              >
                {mapData.attributionText}
              </a>
            </p>
          </div>
        </div>
      ) : (
        <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 space-y-3">
          <p class="text-sm text-amber-950">
            Aún no hay coordenadas exactas cargadas para previsualizar el mapa de esta sede.
            Puedes usar la dirección textual o buscar la ubicación directamente en mapa abierto.
          </p>
          {fallbackSearch && (
            <a
              href={fallbackSearch.searchUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-800 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 transition-colors"
            >
              Buscar ubicación en {fallbackSearch.providerName}
            </a>
          )}
        </div>
      )}
    </div>
  )}

  {isRemoteOrHybrid && (
    <div
      class:list={[
        'rounded-xl border border-sky-200 bg-sky-50/60 p-5 space-y-2',
        isPhysicalOrHybrid ? 'mt-2' : '',
      ]}
    >
      <p class="text-xs font-semibold uppercase tracking-wide text-sky-800">
        {event.modality === 'remoto' ? 'Experiencia 100% remota' : 'Participación remota disponible'}
      </p>
      <p class="text-base font-semibold text-slate-900">
        {event.location}
      </p>
      <p class="text-sm text-slate-700 leading-relaxed">
        Horario oficial de referencia: <strong class="font-semibold text-slate-900">{event.timezone}</strong>.
        Te recomendamos conectarte 10 minutos antes del inicio para verificar audio, video y tu zona horaria local en LATAM.
      </p>
    </div>
  )}
</section>
