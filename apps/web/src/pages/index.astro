---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isValidModality, type EventModality } from '../domain/events/event.types';
import { eventRepository } from '../infrastructure/db/in-memory-event.repository';

const modalityParam = Astro.url.searchParams.get('modality');
const activeModality: EventModality | undefined =
  modalityParam && isValidModality(modalityParam) ? modalityParam : undefined;

const events = await eventRepository.findAll(
  activeModality ? { modality: activeModality } : undefined
);

const modalityLabels: Record<EventModality, string> = {
  presencial: 'Presencial',
  remoto: 'Remoto',
  hibrido: 'Híbrido',
};

const modalityStyles: Record<EventModality, string> = {
  presencial: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  remoto: 'bg-sky-50 text-sky-800 ring-sky-200',
  hibrido: 'bg-violet-50 text-violet-800 ring-violet-200',
};

function formatDate(dateIso: string): string {
  return new Intl.DateTimeFormat('es-419', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(new Date(dateIso));
}

function formatPrice(priceUsd: number): string {
  return priceUsd === 0 ? 'Gratuito' : `USD $${priceUsd}`;
}
---

<BaseLayout>
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <div class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 ring-1 ring-inset ring-brand-100">
          Eventos en toda Latinoamérica
        </p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Experiencias únicas, presenciales y remotas.
        </h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Descubre conferencias, talleres y encuentros de tecnología, diseño, negocios y comunidad cerca de ti o desde cualquier lugar.
        </p>
      </div>
    </div>
  </section>

  <section id="eventos" aria-labelledby="titulo-eventos" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="titulo-eventos" class="text-2xl font-bold tracking-tight text-slate-900">
          Próximos eventos ({events.length})
        </h2>
        <p class="mt-1 text-sm text-slate-600">
          Elige cómo quieres participar: en persona, en línea o en formato híbrido.
        </p>
      </div>

      <nav aria-label="Filtrar eventos por modalidad" class="flex flex-wrap gap-2">
        <a
          href="/#eventos"
          aria-current={!activeModality ? 'page' : undefined}
          class:list={[
            'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
            !activeModality
              ? 'bg-brand-600 text-white'
              : 'bg-white text-slate-700 ring-1 ring-slate-200 hover:bg-slate-100',
          ]}
        >
          Todos
        </a>
        {(['presencial', 'remoto', 'hibrido'] as const).map((mod) => (
          <a
            href={`/?modality=${mod}#eventos`}
            aria-current={activeModality === mod ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
              activeModality === mod
                ? 'bg-brand-600 text-white'
                : 'bg-white text-slate-700 ring-1 ring-slate-200 hover:bg-slate-100',
            ]}
          >
            {modalityLabels[mod]}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {events.map((event) => {
        const availableSeats = Math.max(0, event.capacity - event.registeredCount);
        return (
          <article class="event-card-container rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between gap-5">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span
                  class:list={[
                    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset',
                    modalityStyles[event.modality],
                  ]}
                >
                  {modalityLabels[event.modality]}
                </span>
                <span class="text-xs font-medium uppercase tracking-wide text-slate-500">
                  {event.category}
                </span>
              </div>

              <h3 class="mt-3 text-xl font-bold text-slate-900">
                {event.title}
              </h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                {event.summary}
              </p>
            </div>

            <dl class="grid grid-cols-2 gap-3 border-t border-slate-100 pt-4 text-sm">
              <div>
                <dt class="text-xs font-medium text-slate-500">Fecha y zona horaria</dt>
                <dd class="mt-0.5 font-medium text-slate-800">
                  <time datetime={event.dateIso}>{formatDate(event.dateIso)}</time>
                  <span class="block text-xs font-normal text-slate-500">{event.timezone}</span>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-medium text-slate-500">Ubicación / Acceso</dt>
                <dd class="mt-0.5 font-medium text-slate-800">
                  {event.city}, {event.country}
                  <span class="block text-xs font-normal text-slate-500">{event.location}</span>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-medium text-slate-500">Entrada</dt>
                <dd class="mt-0.5 font-semibold text-brand-700">{formatPrice(event.priceUsd)}</dd>
              </div>
              <div>
                <dt class="text-xs font-medium text-slate-500">Cupos disponibles</dt>
                <dd class="mt-0.5 font-medium text-slate-800">
                  {availableSeats} de {event.capacity}
                </dd>
              </div>
            </dl>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
